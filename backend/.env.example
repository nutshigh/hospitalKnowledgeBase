# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# Milvus (独立部署，非嵌入式)
MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis (embedding 向量缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# EMBED_CACHE_TTL=604800

# === 后端选择 ===
LLM_PROVIDER=local          # local | remote

# Embedding Provider: local | remote
EMBED_PROVIDER=local
# 本地 Embedding（EMBED_PROVIDER=local 时生效，sentence-transformers 直接加载）
EMBED_MODEL_NAME=BAAI/bge-m3
# EMBED_CACHE_DIR=  # 可选，自定义模型缓存目录
# 远端 Embedding（EMBED_PROVIDER=remote 时生效）
REMOTE_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REMOTE_EMBED_API_KEY=
REMOTE_EMBED_MODEL=text-embedding-v3

# OCR (DeepSeek-OCR-2 本地部署 via vLLM serve)
# 启动方式:
#   git clone https://github.com/deepseek-ai/DeepSeek-OCR-2.git
#   vllm serve deepseek-ai/DeepSeek-OCR-2 --port 8001 --trust-remote-code \
#     --max-model-len 8192 --gpu-memory-utilization 0.9 \
#     --no-enable-prefix-caching --mm-processor-cache-gb 0
OCR_BASE_URL=http://localhost:8001/v1
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
# OCR_PROMPT=  # 可选，自定义 OCR prompt，空则用内置默认

# vLLM (OpenAI-compatible API)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_CHAT_MODEL=qwen2.5
VLLM_VISION_MODEL=qwen-vl
VLLM_EMBED_MODEL=bge-m3

# === 远端 API (OpenAI 兼容) ===
REMOTE_LLM_BASE_URL=https://api.deepseek.com/v1
REMOTE_LLM_API_KEY=sk-xxxxxxxx
REMOTE_LLM_MODEL=deepseek-chat
REMOTE_LLM_MAX_TOKENS=4096
REMOTE_LLM_TEMPERATURE=0.1

# === 通用 ===
LLM_TIMEOUT_SECONDS=120

# JWT
SECRET_KEY=dev-secret-key-change-in-production

# File Storage
FILE_STORAGE_ROOT=./storage

# App
DEBUG=true

# External resolver (批量上传按身份证后六位分发:未配置则默认无匹配,防误落库)
# EXTERNAL_RESOLVER_URL=http://example.com/api/id-card-resolve
# EXTERNAL_RESOLVER_TIMEOUT=10

# External App app-login:外部 App 免密登录(持 key 代用户取 token)
# APP_API_KEY=changeme
# APP_LOGIN_TOKEN_EXPIRE_MINUTES=10080

# Logging
LOG_LEVEL=INFO
